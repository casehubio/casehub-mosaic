{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@casehubio/mosaic-*": ["../../components/*/src/index.ts"],
      "@casehubio/mosaic-core": ["../mosaic-core/src/index.ts"],
      "@casehubio/mosaic-core/*": ["../mosaic-core/src/*"]
    }
  },
  "include": ["src"]
}
